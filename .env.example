# Single env file for the whole project (API, local dev and Docker/Traefik).
# Copy to .env and fill in. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=5001
# Local dev database. In Docker the API gets its own URI from docker-compose.yml.
MONGODB_URI=mongodb://127.0.0.1:27017/nirapad_courier
# Long random string: openssl rand -hex 32  (required for Docker)
JWT_SECRET=

# --- Docker / Traefik (server deployment only) ---
# Public hostname Traefik should answer for
DOMAIN=nirapadcourier.sequenceit.software
MONGO_USER=nirapad
MONGO_PASSWORD=
# Match your existing Traefik setup
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
CERT_RESOLVER=letsencrypt
