# Copy to .env on the server and fill in. Never commit .env.

# Public hostname Traefik should answer for
DOMAIN=courier.example.com

# Long random string: openssl rand -hex 32
JWT_SECRET=

# MongoDB (internal only)
MONGO_USER=nirapad
MONGO_PASSWORD=

# Traefik: match your existing setup
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
CERT_RESOLVER=letsencrypt
